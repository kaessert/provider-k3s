for: k3s.m.crossplane.io/v1alpha1/Node
# A live run (2026-09-02) measured the referenced Cluster's own SSH
# install at 19m25s (1165s) end to end, and Node can't even Connect()
# until that Cluster's connection secret exists -- so Node's own
# window has to cover the full Cluster install before its own SSH
# agent join can even start. This value covers a full-length Cluster
# install (see the Cluster annotation below) plus room for the Node's
# own join and readiness confirmation on the same class of host.
uptest.upbound.io/timeout: "3000"
---
for: k3s.m.crossplane.io/v1alpha1/Cluster
uptest.upbound.io/pre-delete-hook: ./testhooks/delete-node-namespaced.sh
# A live run (2026-09-02) measured this SSH-based k3s server install
# (download + systemd unit + readiness wait) at 19m25s (1165s) on a
# nested/systemd-in-container test host -- against the 1200s shared
# default assert window that leaves only ~35s of margin. This value
# gives ~635s of margin over the observed duration.
uptest.upbound.io/timeout: "1800"
